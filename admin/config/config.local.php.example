<?php
/**
 * Local config – single place for this installation.
 * Copy to config.local.php and set your values. Never commit config.local.php.
 *
 * - Database: set DB_* for this environment.
 * - BASE_PATH: required when the app is in a subfolder (e.g. simuze-mdlr).
 *   Without it, theme/admin links may point to /modular instead of your folder.
 */

define('DB_HOST', '127.0.0.1');
define('DB_PORT', '3306');   // MAMP: 8889
define('DB_USER', 'root');
define('DB_PASS', 'your_password');
define('DB_NAME', 'mdlr-simuze');

// Required when the app is in a subfolder (e.g. localhost/simuze-mdlr).
// Set to '' when deployed at document root (staging/production).
define('BASE_PATH', '/simuze-mdlr');  // '' for root, '/simuze-mdlr' for subfolder

// Simezu auth & API — required for all environments.
define('SIMEZU_APP_API_TOKEN', '');   // sk_live_... from Simezu Tokens tab
define('SIMEZU_APP_ID',        '');   // UUID from Simezu App settings
define('SIMEZU_API_KEY',       '');   // API key from Simezu App settings
define('SIMEZU_JWT_SECRET',    '');   // Shared JWT secret with Simezu auth server

// Simezu URLs — override for staging/production.
