# BEGIN Modular
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /simuze-mdlr/
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>
# END Modular
