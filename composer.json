{
    "name": "modular/cms",
    "description": "Modular CMS - A flexible, component-based content management system",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Modular\\": "core/",
            "Modular\\Admin\\": "admin/",
            "Modular\\Tests\\": "public/tests/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modular\\Tests\\": "public/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 core/ admin/",
        "stan": "phpstan analyse core/ admin/",
        "migrate": "php core/migrations/migrate.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}


